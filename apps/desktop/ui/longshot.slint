// Long screenshot: a control panel beside the region. It always stays outside the
// captured region, so it never ends up in the image. (No frame windows: Windows gives
// top-level windows a minimum size, so a thin border window would cover the region.)
import { Theme } from "theme.slint";
import { ActionButton } from "widgets.slint";

export component LongShotPanel inherits Window {
    no-frame: true;
    always-on-top: true;
    title: "ShareReady 长截图";
    width: 300px; height: 96px;
    background: transparent;
    default-font-family: Theme.font-ui;

    in property <int> stitched-height;
    in property <string> state; // "" | "lost" | "full"
    callback finish();
    callback cancel();

    Rectangle {
        border-radius: 12px; background: Theme.bg-card; border-width: 1px; border-color: Theme.line-strong;
        accessible-role: groupbox; accessible-label: "长截图 已拼接 " + root.stitched-height + " 像素";
        VerticalLayout { padding: 12px; spacing: 6px;
            Text { text: root.state == "full" ? "已到长度上限，点“完成”" : "长截图：慢慢向下滚动刚才选的区域"; font-size: 13px; font-weight: 500; color: Theme.ink; }
            Text { text: root.state == "lost" ? "滚动太快，没接上——请往回滚一点" : "已拼接 " + root.stitched-height + " 像素高";
                font-size: 12px; color: root.state == "lost" ? Theme.error : Theme.mute; }
            HorizontalLayout { spacing: 8px; alignment: end;
                ActionButton { label: "取消"; key: ""; kind: 0; clicked => { root.cancel(); } }
                ActionButton { label: "完成"; key: ""; kind: 1; clicked => { root.finish(); } }
            }
        }
    }
}
