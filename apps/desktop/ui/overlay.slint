// S1 capture overlay: one frameless top-most window per monitor showing the frozen pixels.
// All geometry is computed in Rust; rectangles here are overlay-local logical px.
import { Theme } from "theme.slint";
import { ActionButton, Keycap } from "widgets.slint";

export struct Box { x: length, y: length, w: length, h: length }

export component CaptureOverlay inherits Window {
    no-frame: true;
    always-on-top: true;
    title: "ShareReady 截图";
    background: black;
    default-font-family: Theme.font-ui;

    in property <image> shot;
    in property <bool> has-selection;
    in property <Box> selection;
    in property <bool> has-hover;
    in property <Box> hover;
    in property <string> size-text;
    in property <bool> show-magnifier;
    in property <length> cursor-x; in property <length> cursor-y;
    // magnifier source window in shot pixels
    in property <int> mag-x; in property <int> mag-y;
    in property <string> mag-text;
    in property <bool> show-hint: true;
    // "new" | "move" | "nwse" | "nesw" | "ew" | "ns": what a press would grab (Rust decides).
    in property <string> cursor-kind: "new";
    // Selection toolbar: shown once a selection exists and no button is held.
    in property <bool> show-toolbar;

    callback pointer-down(length, length);
    callback pointer-move(length, length);
    callback pointer-up(length, length);
    callback confirm();
    callback cancel();
    callback action(string); // "copy" | "save" | "edit" | "cancel"

    forward-focus: keys;
    keys := FocusScope {
        key-pressed(e) => {
            if e.text == Key.Escape { root.cancel(); return accept; }
            if e.text == Key.Return { root.confirm(); return accept; }
            // Ctrl+C / Ctrl+S may arrive as the letter or as its control character.
            if root.has-selection && e.modifiers.control && (e.text == "c" || e.text == "C" || e.text == "\u{3}") { root.action("copy"); return accept; }
            if root.has-selection && e.modifiers.control && (e.text == "s" || e.text == "S" || e.text == "\u{13}") { root.action("save"); return accept; }
            reject
        }
        Image { width: parent.width; height: parent.height; source: root.shot; image-fit: fill; image-rendering: pixelated; accessible-role: none; }

        // Dim everything except the selection (or hovered window).
        property <Box> lit: root.has-selection ? root.selection : root.has-hover ? root.hover : { x: 0, y: 0, w: 0, h: 0 };
        Rectangle { x: 0; y: 0; width: parent.width; height: lit.y; background: Theme.scrim; }
        Rectangle { x: 0; y: lit.y + lit.h; width: parent.width; height: parent.height - lit.y - lit.h; background: Theme.scrim; }
        Rectangle { x: 0; y: lit.y; width: lit.x; height: lit.h; background: Theme.scrim; }
        Rectangle { x: lit.x + lit.w; y: lit.y; width: parent.width - lit.x - lit.w; height: lit.h; background: Theme.scrim; }

        if root.has-selection || root.has-hover: Rectangle {
            x: lit.x - 1px; y: lit.y - 1px; width: lit.w + 2px; height: lit.h + 2px; border-width: 1px; border-color: white;
            Rectangle { x: -1px; y: -1px; width: parent.width + 2px; height: parent.height + 2px; border-width: 1px; border-color: Theme.select-bg; }
        }
        if root.has-selection: Rectangle {
            x: lit.x; y: max(0px, lit.y - 24px); width: sl.preferred-width + 12px; height: 20px;
            border-radius: 6px; background: Theme.bg-card; border-width: 1px; border-color: Theme.line-strong;
            sl := Text { text: root.size-text; font-family: Theme.font-mono; font-size: 11px; color: Theme.ink; vertical-alignment: center; }
        }
        // Eight grips: drag an edge or corner to adjust, drag inside to move.
        if root.has-selection: Rectangle {
            x: lit.x; y: lit.y; width: lit.w; height: lit.h;
            for g in [{fx: 0, fy: 0}, {fx: 0.5, fy: 0}, {fx: 1, fy: 0}, {fx: 0, fy: 0.5}, {fx: 1, fy: 0.5}, {fx: 0, fy: 1}, {fx: 0.5, fy: 1}, {fx: 1, fy: 1}]: Rectangle {
                x: parent.width * g.fx - 4px; y: parent.height * g.fy - 4px; width: 8px; height: 8px;
                border-radius: 2px; background: white; border-width: 1.5px; border-color: Theme.select-bg;
            }
        }

        TouchArea {
            mouse-cursor: root.cursor-kind == "move" ? move : root.cursor-kind == "nwse" ? nwse-resize : root.cursor-kind == "nesw" ? nesw-resize
                : root.cursor-kind == "ew" ? ew-resize : root.cursor-kind == "ns" ? ns-resize : crosshair;
            pointer-event(e) => {
                if e.button == PointerEventButton.right && e.kind == PointerEventKind.down { root.cancel(); }
                if e.button == PointerEventButton.left && e.kind == PointerEventKind.down { keys.focus(); root.pointer-down(self.mouse-x, self.mouse-y); }
                if e.button == PointerEventButton.left && e.kind == PointerEventKind.up { root.pointer-up(self.mouse-x, self.mouse-y); }
            }
            moved => { root.pointer-move(self.mouse-x, self.mouse-y); }
            double-clicked => { root.confirm(); }
        }

        if root.show-toolbar: tb := Rectangle {
            property <length> bw: row.preferred-width + 12px;
            property <bool> below: lit.y + lit.h + 8px + 44px <= parent.height;
            property <bool> above: lit.y - 8px - 44px >= 0;
            x: max(8px, min(lit.x + lit.w - self.bw, parent.width - self.bw - 8px));
            y: self.below ? lit.y + lit.h + 8px : self.above ? lit.y - 52px : lit.y + lit.h - 52px;
            width: self.bw; height: 44px; border-radius: 10px; background: Theme.bg-card; border-width: 1px; border-color: Theme.line-strong;
            accessible-role: groupbox; accessible-label: "截图操作";
            TouchArea { } // keep clicks on the bar from starting a new selection
            row := HorizontalLayout { x: 6px; spacing: 6px; alignment: center;
                VerticalLayout { alignment: center; ActionButton { label: "取消"; key: "Esc"; kind: 2; clicked => { root.action("cancel"); } } }
                VerticalLayout { alignment: center; ActionButton { label: "编辑"; key: "Enter"; kind: 0; clicked => { root.action("edit"); } } }
                VerticalLayout { alignment: center; ActionButton { label: "保存"; key: "Ctrl S"; kind: 0; clicked => { root.action("save"); } } }
                VerticalLayout { alignment: center; ActionButton { label: "复制"; key: "Ctrl C"; kind: 1; clicked => { root.action("copy"); } } }
            }
        }

        if root.show-magnifier: Rectangle {
            x: min(root.cursor-x + 20px, parent.width - 136px); y: min(root.cursor-y + 20px, parent.height - 160px);
            width: 120px; height: 144px; border-radius: 12px; background: Theme.bg-card; border-width: 1px; border-color: Theme.line-strong; clip: true;
            accessible-role: text; accessible-label: "放大镜 " + root.mag-text;
            Image { x: 1px; y: 1px; width: 118px; height: 118px; source: root.shot; image-rendering: pixelated;
                source-clip-x: root.mag-x; source-clip-y: root.mag-y; source-clip-width: 15; source-clip-height: 15; accessible-role: none; }
            Rectangle { x: 59px; y: 1px; width: 1px; height: 118px; background: Theme.brand; }
            Rectangle { x: 1px; y: 59px; width: 118px; height: 1px; background: Theme.brand; }
            Text { y: 120px; height: 24px; width: parent.width; text: root.mag-text; font-family: Theme.font-mono; font-size: 11px; color: Theme.ink; horizontal-alignment: center; vertical-alignment: center; }
        }

        if root.show-hint: Rectangle {
            x: (parent.width - self.width) / 2; y: parent.height - 56px;
            width: hl.preferred-width + 24px; height: 32px; border-radius: 10px; background: Theme.bg-card; border-width: 1px; border-color: Theme.line-strong;
            hl := HorizontalLayout { padding-left: 12px; spacing: 8px; alignment: center;
                Text { text: root.has-selection ? "Ctrl+C 复制 · Enter 编辑 · 拖边角调整 · 拖内部移动" : "拖拽选区 · 单击选窗口 · Enter 截当前屏幕"; font-size: 12px; color: Theme.ink; vertical-alignment: center; }
                VerticalLayout { alignment: center; Keycap { label: "Esc"; } }
                Text { text: "取消"; font-size: 12px; color: Theme.mute; vertical-alignment: center; }
            }
        }
    }
    init => { keys.focus(); }
}
