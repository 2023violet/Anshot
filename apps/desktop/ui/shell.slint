// S0 tray (02 U05) and the standalone S4 toast shown after the editor closes.
import { Theme } from "theme.slint";
import { Pill, ActionButton } from "widgets.slint";
import { TextEdit } from "std-widgets.slint";

export component Tray inherits SystemTrayIcon {
    icon: @image-url("../assets/icon-32.png");
    in property <string> hotkey-label: "Ctrl+Shift+A";
    tooltip: "安截 Anshot · " + root.hotkey-label + " 截图";
    in property <int> delay-secs: 3;
    callback capture();
    callback delayed-capture();
    callback open-image();
    callback show-editor();
    callback about();
    callback settings();
    callback history();
    callback quit();
    clicked => { root.capture(); }
    Menu {
        MenuItem { title: "截图 (" + root.hotkey-label + ")"; activated => { root.capture(); } }
        MenuItem { title: "延时 " + root.delay-secs + " 秒截图"; activated => { root.delayed-capture(); } }
        MenuItem { title: "打开图片…"; activated => { root.open-image(); } }
        MenuItem { title: "显示编辑窗口"; activated => { root.show-editor(); } }
        MenuItem { title: "截图历史…"; activated => { root.history(); } }
        MenuSeparator { }
        MenuItem { title: "设置…"; activated => { root.settings(); } }
        MenuItem { title: "关于"; activated => { root.about(); } }
        MenuItem { title: "退出"; activated => { root.quit(); } }
    }
}

// Delayed capture: a small countdown in the corner. It is excluded from screen capture, so
// it never ends up in the shot; it takes no focus so menus being opened stay open.
export component CountdownWindow inherits Window {
    no-frame: true;
    always-on-top: true;
    title: "Anshot 延时截图";
    width: 220px; height: 56px;
    background: transparent;
    default-font-family: Theme.font-ui;
    in property <int> remaining;
    callback cancel();
    Rectangle {
        border-radius: 12px; background: Theme.bg-card; border-width: 1px; border-color: Theme.line-strong;
        accessible-role: groupbox; accessible-label: root.remaining + " 秒后截图";
        HorizontalLayout { padding-left: 14px; padding-right: 10px; spacing: 10px;
            Text { text: root.remaining; font-size: 22px; font-weight: 600; color: Theme.brand; vertical-alignment: center; }
            Text { text: "秒后截图"; font-size: 13px; color: Theme.ink; vertical-alignment: center; horizontal-stretch: 1; }
            VerticalLayout { alignment: center;
                Rectangle { width: 52px; height: 28px; border-radius: 6px; background: ta.has-hover ? Theme.bg-hover : transparent;
                    Text { text: "取消"; font-size: 13px; color: Theme.ink; }
                    ta := TouchArea { clicked => { root.cancel(); } accessible-role: button; accessible-label: "取消"; } } }
        }
    }
}

// Recognised text (Windows' own OCR, offline). Editable, never saved; the user copies it.
export component OcrWindow inherits Window {
    title: "Anshot 识别文字";
    always-on-top: true;
    preferred-width: 460px; preferred-height: 340px;
    min-width: 320px; min-height: 220px;
    background: Theme.bg-card;
    default-font-family: Theme.font-ui;
    in property <bool> busy;
    in property <string> error;
    in-out property <string> text;
    callback copy-all(string);
    callback dismiss();
    forward-focus: edit;
    VerticalLayout { padding: 16px; spacing: 10px;
        HorizontalLayout { spacing: 8px;
            Text { text: root.busy ? "正在识别…" : root.error != "" ? "未能识别" : "识别结果"; font-size: 15px; font-weight: 600; color: Theme.ink; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
        }
        if root.error != "": Text { text: root.error; color: Theme.error; font-size: 13px; wrap: word-wrap; }
        edit := TextEdit { text <=> root.text; enabled: !root.busy; font-size: 14px; vertical-stretch: 1; }
        Text { text: "由 Windows 自带的文字识别在本机完成，不联网。结果可能有错字，请核对后再用；被遮挡的内容不会被识别。"; color: Theme.mute; font-size: 12px; wrap: word-wrap; }
        HorizontalLayout { spacing: 8px; alignment: end;
            ActionButton { label: "关闭"; key: "Esc"; kind: 0; clicked => { root.dismiss(); } }
            ActionButton { label: "复制全部"; key: ""; kind: 1; enabled: !root.busy && root.text != ""; clicked => { root.copy-all(root.text); } }
        }
    }
}

export component ToastWindow inherits Window {
    no-frame: true;
    always-on-top: true;
    title: "Anshot";
    width: 300px; height: 64px;
    background: transparent;
    default-font-family: Theme.font-ui;
    in property <string> kind; // "done" | "error" | "warn"
    in property <string> heading;
    in property <string> detail;
    Rectangle {
        border-radius: 12px; background: Theme.bg-card; border-width: 1px; border-color: Theme.line-strong;
        accessible-role: text; accessible-label: root.heading + " " + root.detail;
        HorizontalLayout { padding-left: 14px; padding-right: 14px; spacing: 10px; alignment: start;
            VerticalLayout { alignment: center;
                if root.kind == "done": Pill { label: "✓ 完成"; fill: Theme.pill-done; }
                if root.kind != "done": Rectangle { width: 18px; height: 18px; border-radius: 9px; background: root.kind == "error" ? Theme.error : Theme.warn;
                    Text { text: "!"; color: root.kind == "error" ? white : Theme.ink; font-size: 12px; font-weight: 600; } }
            }
            VerticalLayout { alignment: center;
                Text { text: root.heading; font-size: 13px; font-weight: 500; color: Theme.ink; }
                if root.detail != "": Text { text: root.detail; font-size: 12px; color: Theme.mute; }
            }
        }
    }
}
